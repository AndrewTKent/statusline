# Template for the unattended-jobs publisher systemd user service.
# linux/systemd/install-agents.sh populates HOME and installs it into
# ~/.config/systemd/user/.
#
# Type=oneshot with a paired timer: the job exits after each rewrite, so the
# timer owns the cadence and a failed rewrite cannot turn into a restart loop.

[Unit]
Description=Publish this machine's unattended Claude jobs

[Service]
Type=oneshot
Environment=HOME=__HOME__
Environment=PATH=__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=__HOME__/.local/bin/jobs-publish
